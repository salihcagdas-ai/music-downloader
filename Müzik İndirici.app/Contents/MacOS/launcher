#!/bin/bash
#
# Müzik İndirici — çift tıkla başlatıcı (macOS uygulaması).
# Sunucuyu başlatır ve tarayıcıyı otomatik açar.
# Kapatmak için: açılan sitedeki "⏻ Kapat" butonu (terminal bilmeye gerek yok).
#

# Finder'dan açılınca PATH dar olur; ffmpeg (brew) ve sistem araçları bulunsun diye
# gerekli konumları elle ekliyoruz.
export PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"

# Proje klasörünü bul: bu .app'in bulunduğu klasör
# (.app/Contents/MacOS/launcher  →  üç üst dizin = proje klasörü).
DIR="$(cd "$(dirname "$0")/../../.." && pwd)"
# .app başka yere taşınmışsa sabit yola düş.
if [ ! -f "$DIR/app.py" ]; then
  DIR="/path/to/music-downloader"
fi
cd "$DIR" || exit 1

URL="http://127.0.0.1:5001"

# Sunucu zaten çalışıyorsa (ör. iki kez çift tıklandı): sadece tarayıcıyı aç ve çık.
if curl -s -o /dev/null -m 1 "$URL"; then
  open "$URL"
  exit 0
fi

# Kurulum sağlam mı? (python + flask + yt_dlp import edilebiliyor mu?)
# Değilse: ilk kurulum ya da yarım kalmış/bozuk .venv → temizle ve yeniden kur.
if [ ! -x ".venv/bin/python" ] || ! ./.venv/bin/python -c "import flask, yt_dlp" 2>/dev/null; then
  rm -rf .venv
  PY="$(command -v python3 || echo /usr/bin/python3)"
  "$PY" -m venv .venv \
    && ./.venv/bin/pip install --quiet --upgrade pip \
    && ./.venv/bin/pip install --quiet -r requirements.txt
  # Hâlâ import edilemiyorsa (ör. internet yok): yarım .venv'i sil, uyar, çık.
  # Yoksa sunucu bozuk açılır ve bozuk .venv önbelleğe alınıp her açılış çökerdi.
  if ! ./.venv/bin/python -c "import flask, yt_dlp" 2>/dev/null; then
    rm -rf .venv
    osascript -e 'display alert "Müzik İndirici — Kurulum tamamlanamadı" message "İlk kurulum için internet bağlantısı gerekli. Bağlantınızı kontrol edip uygulamayı tekrar açın." as critical' >/dev/null 2>&1
    exit 1
  fi
fi

# yt-dlp'yi günde bir kez, SUNUCU BAŞLAMADAN güncelle. Arka planda YAPMIYORUZ:
# çalışan venv'i canlı yeniden yazmak, o an yapılan bir indirmeyi bozabilir.
# Günde bir yeterli — hem her açılışı yavaşlatmaz hem YouTube değişimlerine güncel kalır.
STAMP=".venv/.ytdlp-updated"
if [ ! -e "$STAMP" ] || [ -n "$(find "$STAMP" -mtime +0 2>/dev/null)" ]; then
  ./.venv/bin/pip install --quiet --upgrade yt-dlp >/dev/null 2>&1 && touch "$STAMP"
fi

# Tarayıcıyı 2 sn sonra aç; sunucuyu başlat. exec ile bu süreç = sunucu olur,
# böylece "⏻ Kapat" (os._exit) ya da uygulamadan çıkış sunucuyu tam durdurur.
( sleep 2; open "$URL" ) &
exec ./.venv/bin/python app.py
